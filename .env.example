# Optional for ARC-Bench: these values are injected by the Runner.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL=
VISUAL_MODEL=
VISUAL_REVIEW_MODEL=
# Set disabled to use MODEL for code generation while visual models handle planning/review.
ARCBENCH_VISUAL_IMPLEMENTATION=enabled
# Optional implementation thinking override for DeepSeek or Zhipu: enabled / disabled.
ARCBENCH_IMPLEMENTATION_THINKING=
# Optional cost guardrails for one complete website run; lower them for smaller tasks.
ARCBENCH_MAX_MODEL_REQUESTS=250
ARCBENCH_MAX_TOTAL_TOKENS=8000000
